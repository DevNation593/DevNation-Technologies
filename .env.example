NEXT_PUBLIC_SITE_URL=https://devnation.tech
NEXT_PUBLIC_CONTACT_EMAIL=contacto@devnation.tech
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Panel administrativo (/admin) — Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo para los comandos admin:* (nunca en el navegador ni en variables NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=sb_secret_...

# Clave para cifrar la firma subida desde el panel (32 bytes en base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SRI_ENCRYPTION_KEY=

# Respaldo opcional si no se sube la firma en el panel: ruta al .p12 o su contenido en base64
SRI_P12_PATH=
SRI_P12_BASE64=
SRI_P12_PASSWORD=
